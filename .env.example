# Copy to .env.local for local development (`npm run dev`).
# Needs a Postgres running at DATABASE_URL — e.g. `docker compose up -d db`.

DATABASE_URL=postgres://leave:leave@localhost:5432/leave
APP_URL=http://localhost:3000

# Resend email notifications (optional locally)
RESEND_API_KEY=re_your_key
RESEND_FROM=TimeOff <leave@yourcompany.co.za>

# First-run admin seed — created only if no such user exists yet.
SEED_ADMIN_EMAIL=admin@yourcompany.co.za
SEED_ADMIN_PASSWORD=change-me-min-8-chars
SEED_ADMIN_NAME=Administrator

# Approval reminders (optional). Pending requests nudge approvers after
# REMINDER_AFTER_DAYS and escalate to the backup approver / admins after
# ESCALATE_AFTER_DAYS. REMINDERS=off disables the built-in hourly job.
REMINDER_AFTER_DAYS=3
ESCALATE_AFTER_DAYS=5
# Days before a public holiday to email everyone a heads-up (default 7).
HOLIDAY_REMINDER_DAYS=7
REMINDERS=on
# Only needed if an external scheduler calls POST /api/cron/reminders.
CRON_SECRET=
