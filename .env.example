# Copy to .env.local for local development (`npm run dev`).
# Needs a Postgres running at DATABASE_URL — e.g. `docker compose up -d db`.

DATABASE_URL=postgres://leave:leave@localhost:5432/leave
APP_URL=http://localhost:3000

# Resend email notifications (optional locally)
RESEND_API_KEY=re_your_key
RESEND_FROM=TimeOff <leave@yourcompany.co.za>

# First-run admin seed — created only if no such user exists yet.
SEED_ADMIN_EMAIL=admin@yourcompany.co.za
SEED_ADMIN_PASSWORD=change-me-min-8-chars
SEED_ADMIN_NAME=Administrator
