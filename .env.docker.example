# Docker / Portainer stack variables. Copy to .env next to docker-compose.yml
# (or paste these into the Portainer stack's Environment variables).

# --- Postgres ---
POSTGRES_USER=leave
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password
POSTGRES_DB=leave

# --- App ---
APP_PORT=3000
APP_URL=https://leave.zenithlabs.space
RESEND_API_KEY=re_your_key
RESEND_FROM=Leave Dashboard <leave@mediarocket.co.za>

# --- First-run admin (created once, only if the user doesn't exist) ---
SEED_ADMIN_EMAIL=dewald@mediarocket.co.za
SEED_ADMIN_PASSWORD=set-a-strong-password
SEED_ADMIN_NAME=Dewald Pieterse
